##### SERVER

# Port where the backend HTTP server will listen.
PORT=8000

# Public URL of the Bricks frontend (used for CORS, redirects, etc.).
URL=http://localhost:3000

##### DATABASE

# MongoDB connection string for the Bricks database.
# Example: mongodb+srv://user:password@cluster.example.com/Bricks
MONGO_URI=mongodb://USER:PASSWORD@HOST:PORT/Bricks

##### FIREBASE SERVICE ACCOUNT (for auth / messaging / storage)

# Values below typically come from a Firebase service account JSON.
# Do NOT commit real values; use .env.dev or a private .env file locally.
PROJECT_ID=your-firebase-project-id
PRIVATE_KEY_ID=your-firebase-private-key-id
# Multiline private key; keep the \n characters if your code expects them.
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
CLIENT_EMAIL=firebase-adminsdk-xxxx@your-firebase-project-id.iam.gserviceaccount.com
CLIENT_ID=your-firebase-client-id
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER=https://www.googleapis.com/oauth2/v1/certs
CLIENT_URI=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxx%40your-firebase-project-id.iam.gserviceaccount.com
UNIVERSE_DOMAIN=googleapis.com

##### CLOUDINARY (for media storage)

# Full Cloudinary URL (can be generated from Cloudinary dashboard).
# Example: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

##### AI PROVIDERS

# Groq API key for model inference (optional, if enabled).
GROQ_API_KEY=your-groq-api-key

# Google Gemini API key (optional, if enabled).
GEMINI_API_KEY=your-gemini-api-key

##### ADMIN / AUTH KEYS

# Admin public key used for verifying privileged admin tokens.
ADMIN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_ADMIN_PUBLIC_KEY_CONTENT\n-----END PUBLIC KEY-----"

# JWT RSA private key used to sign application tokens.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_JWT_PRIVATE_KEY_CONTENT\n-----END RSA PRIVATE KEY-----"

# JWT RSA public key used to verify application tokens.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_JWT_PUBLIC_KEY_CONTENT\n-----END PUBLIC KEY-----"

# create a env as .env.dev to run the server in development mode
